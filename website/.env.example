# ============================================================
# Braid with Abi — website settings
# Live: Vercel → Project → Settings → Environment Variables.
# On this computer: .env.local
# ============================================================

# Public address of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://braidwithabi.ca

# Database. Supabase → your project → Connect → "Transaction pooler" URI
# (replace [YOUR-PASSWORD] with the database password).
# Leave empty on this computer to use a local database saved in website/.data/
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres

# The owner app's private key. Any long random text — the SAME value goes in
# the owner app as EXPO_PUBLIC_OWNER_KEY. Anyone with it can see bookings,
# so don't share it.
OWNER_KEY=change-me-to-a-long-random-string

# Resend → API Keys (domain braidwithabi.ca must be verified in Resend).
# Without it (this computer only) emails are saved to .email-previews/ instead.
RESEND_API_KEY=re_xxxxxxxxx
# The one business address (Zoho mailbox): emails are sent from it, client
# replies and Abi's "new booking" emails go to it.
BUSINESS_EMAIL=services@braidwithabi.ca

# Phone alerts on iPhone (Web Push). Generate a pair with: npm run vapid
# The PUBLIC key also goes in the owner app (EXPO_PUBLIC_VAPID_PUBLIC_KEY).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

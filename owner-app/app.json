{
  "expo": {
    "name": "Braid with Abi",
    "slug": "braidwithabi-owner",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "braidwithabi",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.braidwithabi.owner"
    },
    "android": {
      "package": "ca.braidwithabi.owner",
      "adaptiveIcon": {
        "backgroundColor": "#2e211d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Braid with Abi",
      "shortName": "Abi",
      "themeColor": "#faf5ef",
      "backgroundColor": "#faf5ef"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#faf5ef"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#a65e4e"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos of your styles to show on your website."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "97c282e5-7236-4d36-baa7-388f602cdebb"
      }
    },
    "owner": "neilware"
  }
}
